extends SceneTree
const Analytics=preload("res://match/match_analytics.gd")
const Modifiers=preload("res://match/probability_modifiers.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var capped: Dictionary=Modifiers.resolve(0.7,[{"id":"skill","amount":0.08},{"id":"manager","amount":0.07},{"id":"risk","amount":-0.04}])
	assert(is_equal_approx(capped.value,0.78) and is_equal_approx(capped.sources[1].applied,0.04))
	assert(Modifiers.resolve(0.99,[{"id":"a","amount":0.12}]).value == 0.95)
	assert(Modifiers.resolve(0.01,[{"id":"a","amount":-0.12}]).value == 0.05)
	var data := Analytics.empty(true)
	Analytics.opportunity(data,"card","bullet_pass","pass",1,true,true)
	Analytics.opportunity(data,"card","bullet_pass","pass",1,true,true)
	assert(data.opportunities["card/pass"].eligible == 1)
	Analytics.probability(data,1,"card","pass",0.7,0.78,capped.sources)
	var report := Analytics.summary([{"kind":"trait_activation","actor_card":"card","trait":"bullet_pass"},{"kind":"trait_result","actor_card":"card","state":"success","reason":"physical reception"}],data)
	assert(report.players[0].activations == 1 and report.players[0].successes == 1 and report.players[0].goals == 0)
	assert(report.manager_actions.manager == 1 and Analytics.valid(data))
	assert(not Analytics.valid({"enabled":true}))
	var Match=load("res://match/match_sim.gd")
	var Snapshot=load("res://match/match_snapshot.gd")
	var reference=Match.new(42,12,null,null,true)
	var observed=Match.new(42,12,null,null,true)
	observed.analytics=Analytics.empty(true)
	for tick in 650:
		reference.step()
		observed.step()
		assert(reference.signature() == observed.signature(),"Telemetry never changes RNG, events or football")
	var resumed=Snapshot.restore(Snapshot.capture(observed))
	assert(resumed != null and resumed.analytics == observed.analytics,"Opportunity and probability metrics resume exactly")
	for tick in 650:
		if reference.period == Match.Period.HALF_TIME:
			reference.acknowledge_halftime(); observed.acknowledge_halftime(); resumed.acknowledge_halftime()
		reference.step(); observed.step(); resumed.step()
		assert(reference.signature() == observed.signature() and observed.signature() == resumed.signature())
		assert(observed.analytics == resumed.analytics)
	assert(not observed.analytics.opportunities.is_empty() and not observed.analytics.probabilities.is_empty())
	print("MASTER INTEGRITY: capped absolute modifiers and real-event attribution passed")
	quit()
